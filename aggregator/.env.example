# Copy to .env, then: cargo run -p metis-aggregator --bin metis-api

# ── Venues ──────────────────────────────────────────────────────────────────
# Jupiter's catalog reads work with NO key (leave this empty); a key is only needed to build orders.
# An empty or wrong key is worse than none: Jupiter answers 401 and the catalog stays empty.
JUPITER_API_KEY=

# Panta needs a key for everything (docs.panta.market). Without it Panta shows no markets.
PANTA_API_KEY=
# Panta's quote endpoint wants a buyer wallet even for a price check. Any valid Solana address.
PANTA_QUOTE_WALLET=
# Panta's market list can omit markets, so open ones are also found on-chain. The public RPC works
# for a try-out and rate-limits under load; use a private one for real use. Optional.
PANTA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Mode ────────────────────────────────────────────────────────────────────
# write (default): builds unsigned transactions for the caller's wallet to sign. The aggregator never
# signs or broadcasts. read: catalog only, nothing can be built.
MODE=write

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
# The UI's origin(s), comma-separated scheme://host[:port]. Leave unset to allow any origin.
CORS_ORIGIN=

# Postgres. Optional: unset means in-memory only (nothing survives a restart). Use the direct
# connection (port 5432), not a transaction-mode pooler. Apply migrations with `sqlx migrate run`.
DATABASE_URL=

# ── Optional: model-assisted event grouping ─────────────────────────────────
# The rules group markets into events on their own. With a key, markets the rules could not place
# (nicknames, paraphrases) are put to Claude, once each, and the answer is cached. Leave empty for
# rules only.
ANTHROPIC_API_KEY=
