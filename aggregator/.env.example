# Copy to .env (or export manually) before running `cargo run -p metis-aggregator --bin metis-api`.

# Panta (required for the Panta adapter to do anything - without it every
# Panta call fails and the venue just shows up unhealthy in /venues/health).
PANTA_API_KEY=
# Panta's quote endpoint requires a buyer wallet even for a pure quote (no
# trade is executed at this stage) - any valid Solana pubkey works here.
PANTA_QUOTE_WALLET=
# Override only for testing against a different Panta environment.
PANTA_BASE_URL=https://live-api.panta.market/api/v1
# Panta markets are discovered on-chain: its /markets/ list stops at 50 rows and
# misses most open markets. A private RPC is recommended; the public one is
# rate-limited. PANTA_DISCOVERY=api falls back to the (incomplete) API list. The RPC URL usually
# carries a provider key: keep it in the environment, never commit it. Error text is scrubbed of
# URLs before it reaches logs, /venues/health or API responses.
PANTA_RPC_URL=https://api.mainnet-beta.solana.com
# PANTA_PROGRAM_ID=6gM5afTQBq5VZCfgpGqcsqzfWd5maLSCKWtGjbEobZMp
# PANTA_DISCOVERY=chain

# Jupiter Prediction (required - get one from https://developers.jup.ag/portal).
# Note: its API also blocks US and South Korea IPs entirely - metis-api must
# run somewhere outside those regions regardless of the key.
JUPITER_API_KEY=
JUPITER_BASE_URL=https://api.jup.ag/prediction/v1
# Programs a Jupiter-built transaction may invoke, beyond its issuer program and the common supporting
# programs (system, token, associated-token, compute-budget, memo). Comma-separated. Leave empty unless a
# build is refused for naming a program you have checked. A refusal is logged at error level.
JUPITER_EXTRA_PROGRAMS=

# ── Venues ────────────────────────────────────────────────────────────────────
#
# Every venue reads its own <ID>_* variables: <ID>_API_KEY, <ID>_BASE_URL, and optional refresh
# settings - <ID>_PAGE_CAP (default 10), <ID>_MIN_REQUEST_GAP_MS (250),
# <ID>_MAX_CONCURRENT_CHAINS (1), <ID>_BREAKER_COOLDOWN_SECS (300). See docs/adding-a-venue.md.
#
# Which venues to actually wire up, comma-separated by id. Panta and Jupiter are both confirmed
# field-for-field against the live APIs.
#
# Note on Panta: its /markets/ list is a registry, not the whole chain, and its rows carry no text
# and a lagging status, so open markets are found on-chain (PANTA_RPC_URL above) and each is
# described by GET /markets/{id}/. Its list cursor paginates correctly (fixed venue-side
# 2026-09-28); the API-only path (PANTA_DISCOVERY=api) still misses markets the registry omits.
ENABLED_VENUES=panta,jupiter

# Categories come from the venues. Names that mean the same thing but are worded differently are
# merged by alias (built in: climate & science=science, tech=technology, pop-culture=culture).
# Add more as from=to pairs; anything without an alias is still served under its own name.
CATEGORY_ALIASES=

# How often the background refresh re-pulls every venue, in seconds. Minimum 30, default 600.
# A full pass measures at 3-4 minutes (Panta ~20s, then Jupiter's ten categories at ~25s each,
# paced to stay under its rate limit), so going much below 600 means refreshing continuously.
# Overlapping passes are prevented by a lock either way. Live prices come from POST /v1/route
# and GET /v1/markets/{venue}/{id}/live, not from this - the refresh only tracks which markets exist
# and when they close.
REFRESH_INTERVAL_SECS=600

# Shared secret for the operator-only routes (POST /refresh, GET /metrics, and the raw venue
# proxy GET /venues/{id}/raw/{path}), sent as the X-Admin-Token header. A refresh is a multi-minute fan-out across every venue, so it is not
# something an anonymous caller should be able to trigger. UNSET MEANS THOSE ROUTES REFUSE EVERY
# REQUEST (503) - they fail closed, not open.
ADMIN_TOKEN=

# Requests per minute per client IP on the public routes. POST /v1/route and
# GET /v1/markets/{venue}/{id}/live cost 10, since they call venues live.
# 0 disables the limit.
RATE_LIMIT_PER_MINUTE=300

# Take the client IP from X-Forwarded-For. Only set true behind a proxy that overwrites that
# header - otherwise any client can claim any address and dodge the limit. Behind a proxy that
# does NOT set it, every client shares the proxy's address and therefore one bucket, so set this
# true there (and only there).
TRUST_FORWARDED_FOR=false

# How many proxies in front of this service append to X-Forwarded-For (1 = one proxy or load
# balancer; 2 = a CDN in front of a load balancer). Only read when TRUST_FORWARDED_FOR=true. The
# client is that many entries from the RIGHT of the header. The leftmost entry is client-supplied
# and is never used, so a forged header cannot pick its own rate-limit bucket.
TRUSTED_PROXY_HOPS=1

# Longest a single API request may run before it is answered 408.
REQUEST_TIMEOUT_SECS=45

# ── Actions that move real money ──────────────────────────────────────────────
#
# Both default to OFF and only the exact word "true" turns them on - a typo fails
# closed, never open. The aggregator never signs and never broadcasts: it builds
# an unsigned transaction and hands it back for the caller's own wallet to sign.
# These switches decide whether it will build one at all.

# Building buy and claim transactions. A buy spends real USDC and cannot be undone. A buy request
# may carry min_shares_out; the build is refused if the venue's own preview falls below it (a
# build-time check, not an on-chain bound).
EXECUTION_ENABLED=false

# Building market-creation transactions. A created market is a permanent public
# artifact carrying the creating wallet's name, and there is no delete. The
# creating wallet pays the fee and earns the market's creator fees.
MARKET_CREATION_ENABLED=false

# Server config
PORT=8080
# The UI's origin(s), exactly scheme://host[:port] - no path, no trailing slash, no wildcard
# (all three are refused at startup). Comma-separate several: production, staging, and any
# preview host you trust. The CORS layer rejects every other origin.
CORS_ORIGIN=http://localhost:3000

# Logging (tracing-subscriber EnvFilter syntax), e.g. "metis_api=debug,info"
RUST_LOG=info
# "json" for structured logs (prod log aggregation) - unset/anything else means plain text.
LOG_FORMAT=

# Postgres. Optional for now - unset means the server runs in-memory-only (nothing persists
# across restarts). Use the DIRECT connection string (port 5432), not a PgBouncer pooler URL -
# sqlx manages its own pool, and transaction-mode PgBouncer pooling can break prepared statements.
# Migrations are a deploy step (`sqlx migrate run`), never run at startup.
DATABASE_URL=
# Connections held by THIS instance. Keep (instances x this value) under the database's
# max_connections, leaving headroom for migrations and admin sessions.
DATABASE_POOL_SIZE=15
