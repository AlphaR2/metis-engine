# Build output
/target
/clients

# Generated by programs/oracle/build.rs (Codama) - regenerate on demand, don't diff it
/idl/oracle.json

# Secrets and local config
.env
.env.*
!.env.example
*.local.json
programs/core/keys
*-keypair.json

# One-off local dumps (scripts/dump-panta-catalog.sh and ad-hoc copies)
*-dump.json

# Local tooling, editors and OS files
.claude/
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
*:Zone.Identifier

# Local validators and logs
test-ledger/
.surfpool/
*.log

# Throwaway keys for the local validator run (never used on a real network)
/localnet/keys/
/localnet/ledger/


# Demo keys and run state written by devnet/*.sh (hot keys for the demo only; never commit)
/devnet/keys-*/
devnet/keys-devnet/root1.json
# Scratch written by the localnet harness while it runs (markets, watch lists, mock state)
/localnet/*.txt
/localnet/state-*.json
/localnet/watch*.json
/localnet/kickoff
/localnet/t0
